    "margin": {
      "top": "64px",
      "right": "72px",
      "bottom": "64px",
      "left": "72px"
    },
    "breaks": "authored",
    "_breaks설명": "authored — 원본 HTML 의 쪽(.bd-page) 그대로(넘치면 검사 실패). flow — HTML · Word 모두 글을 이어 흘려 쪽을 저절로 나눈다(장 제목이 쪽 끝에 홀로 남지 않게)."
  },
  "font": {
    "word": "Pretendard",
