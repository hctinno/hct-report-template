# 설정 예시. `.env` 로 복사해 값을 채운다.
# 실제 환경변수가 이 파일의 값을 덮는다.

# --- 추론 백엔드 ---
# ollama | mock
ONPREM_BACKEND=ollama
# 루프백만 허용. 외부 주소를 넣으면 설정 단계에서 거부된다.
ONPREM_BASE_URL=http://127.0.0.1:11434
ONPREM_CHAT_MODEL=gemma3:12b
ONPREM_EMBED_MODEL=bge-m3
ONPREM_TEMPERATURE=0.2
ONPREM_NUM_CTX=8192

# --- RAG ---
ONPREM_CORPUS_DIR=data/corpus
ONPREM_INDEX_DIR=var/index
ONPREM_CHUNK_SIZE=700
ONPREM_CHUNK_OVERLAP=120
ONPREM_TOP_K=5
ONPREM_CANDIDATE_K=30

# --- 하네스 ---
ONPREM_CONTEXT_BUDGET_CHARS=6000
ONPREM_REFUSE_WITHOUT_EVIDENCE=true

# --- 보안 ---
# 운영에서는 true 를 유지한다. 격리 점검 실패 시 명령이 실행되지 않는다.
ONPREM_ENFORCE_ISOLATION=true
ONPREM_REDACT_SECRETS=true
ONPREM_AUDIT_LOG=var/audit/audit.jsonl
